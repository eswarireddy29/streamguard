# ============================================
# StreamGuard Configuration — EXAMPLE
# Copy to .env and fill in real values.
# Never put real secrets in this file.
# ============================================

# --- Application ---
APP_NAME=StreamGuard
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=console

# --- Database (PostgreSQL — installed in Task 4) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=streamguard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# --- Paths (relative to project root) ---
DATA_DIR=data
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
EVENT_LOG_DIR=data/events
MODEL_DIR=data/models
LOG_DIR=logs

# --- Synthetic data generation ---
RANDOM_SEED=42
N_CUSTOMERS=5000
N_MERCHANTS=800
SIMULATION_DAYS=90
FRAUD_RATE=0.004

# --- Fraud scoring thresholds ---
SCORE_THRESHOLD_REVIEW=0.35
SCORE_THRESHOLD_BLOCK=0.80

# --- Cost model (rupees) ---
COST_FALSE_NEGATIVE=5000
COST_FALSE_POSITIVE=200

# --- API ---
API_HOST=127.0.0.1
API_PORT=8000